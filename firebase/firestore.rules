rules_version = '2';

// Single-user app: all data lives under users/owner, and only an instance of the app (signed in
// anonymously with this project's configuration) can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/owner/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
